# ─────────────────────────────────────────────────────────────────────────
# Database — Supabase Postgres.
# Dashboard: https://supabase.com/dashboard -> your project -> Settings -> Database
# ─────────────────────────────────────────────────────────────────────────
# Connection pooling -> Transaction pooler (port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connection pooling -> Direct connection (port 5432). Used only for `prisma migrate`.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables real transactional email via Resend (contact form + newsletter).
# Leave blank to have the app log emails to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="The Foodie <onboarding@resend.dev>"